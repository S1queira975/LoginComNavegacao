@startuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam arrowColor #333333
skinparam packageBackgroundColor #f0f0f0
skinparam packageBorderColor #666666
skinparam backgroundColor white

title Diagrama de Classes - Modelo de Domínio

' =======================
' ENUMS
' =======================
package "model.enums" {

  enum StatusAgendamento {
    PENDENTE
    CONFIRMADO
    CANCELADO
    REALIZADO
    + getDescricao(): String
  }

  enum TipoSanguineo {
    A, B, AB, O
    + getValor(): String
    + fromValor(String): TipoSanguineo
    + fromValorCompleto(String): TipoSanguineo
  }

  enum FatorRh {
    POSITIVO, NEGATIVO
    + getValor(): String
    + fromValor(String): FatorRh
  }

  enum StatusBolsa {
    DISPONIVEL
    RESERVADA
    UTILIZADA
    VENCIDA
    + getDescricao(): String
  }
}

' =======================
' USER
' =======================
package "model.user" {

  abstract class User {
    - nome: String
    - email: String
    - senha: String
    + getNome(): String
    + setNome(String)
    + getEmail(): String
    + setEmail(String)
    + getSenha(): String
    + setSenha(String)
  }

  class Doador {
    - cpf: String
    - tipoSanguineo: TipoSanguineo
    - fatorRh: FatorRh
    + getCpf(): String
    + setCpf(String)
    + getTipoSanguineo(): TipoSanguineo
    + setTipoSanguineo(TipoSanguineo)
    + getFatorRh(): FatorRh
    + setFatorRh(FatorRh)
    + getTipoCompleto(): String
  }

  User <|-- Doador
}

' =======================
' ENTITIES
' =======================
package "model.entity" {

  class Hemocentro {
    - id: String
    - nome: String
    - endereco: Endereco
    - telefone: String
    - email: String
    - horarioAbertura: String
    - horarioFechamento: String
    - funcionamento24Horas: boolean
    - capacidadeColeta: double
    + getHorarioFuncionamento(): String
  }

  class Endereco {
    - logradouro: String
    - numero: String
    - complemento: String
    - bairro: String
    - cidade: String
    - estado: String
    - cep: String
    + getEnderecoCompleto(): String
  }

  class Agendamento {
    - id: String
    - data: String
    - hora: String
    - hemocentro: Hemocentro
    - cpfDoador: String
    - status: StatusAgendamento
    + isPendente(): boolean
    + isCancelado(): boolean
    + isRealizado(): boolean
    + cancelar()
    + marcarRealizado()
  }

  class BolsaSangue {
    - codigo: String
    - tipoSanguineo: TipoSanguineo
    - fatorRh: FatorRh
    - dataColeta: String
    - dataValidade: String
    - volumeMl: int
    - quantidade: int
    - status: StatusBolsa
    - hemocentroOrigem: Hemocentro
    - agendamentoId: String
    + fromAgendamento(Agendamento, TipoSanguineo, FatorRh, int, int): BolsaSangue
    + getTipoCompleto(): String
  }

}

' =======================
' ADAPTER
' =======================
package "adapter" {

  abstract class RecyclerView.Adapter

  class MenuHomeAdapter {
    - itens: List<ItemMenu>
    + onCreateViewHolder()
    + onBindViewHolder()
    + getItemCount()
  }

  class AgendamentoAdapter {
    - agendamentos: List<Agendamento>
    - listener: OnAgendamentoClickListener
    + onCreateViewHolder()
    + onBindViewHolder()
    + getItemCount()
  }

  class AgendamentoParaRegistroAdapter {
    - agendamentos: List<Agendamento>
    - listener: OnAgendamentoSelecionadoListener
    + onCreateViewHolder()
    + onBindViewHolder()
    + getItemCount()
  }

  class BolsaSangueAdapter {
    - bolsas: List<BolsaSangue>
    + onCreateViewHolder()
    + onBindViewHolder()
    + getItemCount()
  }

  RecyclerView.Adapter <|-- MenuHomeAdapter
  RecyclerView.Adapter <|-- AgendamentoAdapter
  RecyclerView.Adapter <|-- AgendamentoParaRegistroAdapter
  RecyclerView.Adapter <|-- BolsaSangueAdapter
}

' =======================
' RELAÇÕES
' =======================

' Herança - user
Doador --|> User

' Herança - adapter
MenuHomeAdapter --|> RecyclerView.Adapter
AgendamentoAdapter --|> RecyclerView.Adapter
AgendamentoParaRegistroAdapter --|> RecyclerView.Adapter
BolsaSangueAdapter --|> RecyclerView.Adapter

' Composição
Hemocentro *-- Endereco

' Associações
Agendamento --> Hemocentro
BolsaSangue --> Hemocentro
AgendamentoAdapter --> Agendamento
AgendamentoParaRegistroAdapter --> Agendamento
BolsaSangueAdapter --> BolsaSangue

@enduml