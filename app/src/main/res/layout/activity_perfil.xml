<?xml version="1.0" encoding="utf-8"?>
<!--
    Perfil do doador, no estilo de um cartazinho.

    Tudo dentro de UM cartão, em faixas empilhadas que se encaixam:
      1. cabeçalho vermelho com a marca (cantos de cima arredondados)
      2. corpo com iniciais, nome, email e o selo grande do tipo sanguíneo
      3. rodapé tonal fechando o cartão (cantos de baixo arredondados)
    As três faixas somam um objeto só, como um cartão impresso.

    Cartão somente-leitura; para mudar alguma coisa o doador entra em
    EditarPerfilActivity. Todas as cores saem dos tokens do tema, então claro e
    escuro mantêm o mesmo contraste.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootConteudo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/conteudo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/space_l"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/tela_perfil_titulo"
                android:textAppearance="@style/TextAppearance.App.Display" />

            <!-- =================== O cartazinho =================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ===== 1. Cabeçalho: a marca ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cartao_header"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_l"
                        android:paddingTop="@dimen/space_m"
                        android:paddingEnd="@dimen/space_l"
                        android:paddingBottom="@dimen/space_m">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_logo_badge"
                            android:padding="@dimen/space_2xs">

                            <ImageView
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_drop"
                                app:tint="@color/brand_on_badge" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/app_name"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                android:textColor="@color/on_hero" />

                            <!-- Rótulo impresso: maiúsculas e espaçadas -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.12"
                                android:text="@string/tela_perfil_adesivo"
                                android:textAllCaps="true"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/on_hero_variant" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ===== 2. Corpo: quem é + o que doou ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_l"
                        android:paddingTop="@dimen/space_l"
                        android:paddingEnd="@dimen/space_l">

                        <FrameLayout
                            android:layout_width="@dimen/icon_size_l"
                            android:layout_height="@dimen/icon_size_l"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="@dimen/space_2xs">

                            <TextView
                                android:id="@+id/txtIniciais"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/tela_perfil_inicial_padrao"
                                android:textAppearance="@style/TextAppearance.App.BloodType" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtNome"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/tela_perfil_nome_padrao"
                                android:textAppearance="@style/TextAppearance.App.Headline" />

                            <TextView
                                android:id="@+id/txtEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3xs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <!-- Selo grande: o miolo do cartazinho -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/space_m"
                            android:background="@drawable/bg_cartao_tipo"
                            android:gravity="center"
                            android:minWidth="72dp"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/space_m"
                            android:paddingTop="@dimen/space_s"
                            android:paddingEnd="@dimen/space_m"
                            android:paddingBottom="@dimen/space_s">

                            <TextView
                                android:id="@+id/txtTipoSanguineo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="@string/tela_perfil_tipo_padrao"
                                android:textAppearance="@style/TextAppearance.App.Metric"
                                android:textColor="@color/on_hero" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="@dimen/space_3xs"
                                android:text="@string/tela_perfil_tipo_selo"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="@color/on_hero_variant" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_marginEnd="@dimen/space_l"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- ===== Faixa do nível: a barra enche até 3 registros ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_l"
                        android:paddingTop="@dimen/space_m"
                        android:paddingEnd="@dimen/space_l"
                        android:paddingBottom="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/tela_perfil_nivel_titulo"
                                android:textAppearance="@style/TextAppearance.App.Title" />

                            <TextView
                                android:id="@+id/txtNivelProgresso"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/barNivel"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/progress_thickness"
                            android:layout_marginTop="@dimen/space_s"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackColor="?attr/colorOutlineVariant"
                            app:trackCornerRadius="@dimen/progress_corner_radius"
                            app:trackThickness="@dimen/progress_thickness" />
                    </LinearLayout>

                    <!-- ===== 3. Dados, como os campos de um cartão impresso ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_l"
                        android:paddingTop="@dimen/space_m"
                        android:paddingEnd="@dimen/space_l"
                        android:paddingBottom="@dimen/space_l">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="@string/tela_perfil_campo_nome"
                                android:textAllCaps="true"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <TextView
                                android:id="@+id/txtNomeDado"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3xs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/tela_perfil_nome_padrao"
                                android:textAppearance="@style/TextAppearance.App.Title" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="@string/tela_perfil_campo_email"
                                android:textAllCaps="true"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <TextView
                                android:id="@+id/txtEmailDado"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3xs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.App.Body" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_marginEnd="@dimen/space_l"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- CPF ocupa a linha inteira, porque é longo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_l"
                        android:paddingTop="@dimen/space_m"
                        android:paddingEnd="@dimen/space_l"
                        android:paddingBottom="@dimen/space_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/tela_perfil_campo_cpf"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/txtCpf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3xs"
                            android:text="@string/tela_perfil_cpf_nao_informado"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3xs"
                            android:text="@string/tela_perfil_cpf_fixo"
                            android:textAppearance="@style/TextAppearance.App.Caption" />
                    </LinearLayout>

                    <!-- ===== 4. Rodapé: fecha o cartão ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cartao_footer"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_l"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/space_l"
                        android:paddingBottom="@dimen/space_s">

                        <ImageView
                            android:layout_width="@dimen/icon_size_s"
                            android:layout_height="@dimen/icon_size_s"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_drop"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:layout_weight="1"
                            android:letterSpacing="0.08"
                            android:text="@string/tela_perfil_rodape"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tela_perfil_papel"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/tela_perfil_editar"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoltar"
                style="@style/Widget.App.Button.Text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/tela_voltar" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
