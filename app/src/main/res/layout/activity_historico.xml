<?xml version="1.0" encoding="utf-8"?>
<!--
    Histórico de doações.

    O RecyclerView usa AutoFitGridLayoutManager: o número de colunas é derivado da
    largura útil da tela, então a lista se reorganiza sozinha em tablets.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootConteudo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/conteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_l"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <!-- ===== Cabeçalho ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_history"
                app:tint="@color/on_hero" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tela_historico_titulo"
                    android:textAppearance="@style/TextAppearance.App.Display"
                    android:textColor="@color/on_hero" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3xs"
                    android:text="@string/tela_historico_subtitulo"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/on_hero_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Lista ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDoacoes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_m"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_xs"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/txtSemAgendamentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:drawablePadding="@dimen/space_m"
            android:gravity="center"
            android:text="@string/tela_historico_vazio"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:visibility="gone"
            app:drawableTopCompat="@drawable/ic_inbox"
            app:drawableTint="?attr/colorOutline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltar"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/tela_voltar"
            app:icon="@drawable/ic_history"
            app:iconGravity="textStart" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>