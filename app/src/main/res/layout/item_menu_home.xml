<?xml version="1.0" encoding="utf-8"?>
<!-- Card de ação do menu da Home. As cores vêm do tema, então o contraste é automático. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.MenuCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_3xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <ImageView
            android:id="@+id/imgIcone"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@null"
            android:padding="@dimen/space_2xs"
            app:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xs"
                android:textAppearance="@style/TextAppearance.App.Caption" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>