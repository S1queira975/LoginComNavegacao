<?xml version="1.0" encoding="utf-8"?>
<!--
    Confirmação da coleta de um agendamento escolhido na tela anterior.

    Data e local chegam prontos do agendamento e ficam travados (sem foco, sem
    cursor, com cadeado no campo), para que o registro nunca divirja do que o
    doador agendou. O agente de saúde informa só o que ele mediu na sessão:
    volume por bolsa e quantidade de bolsas.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootConteudo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/conteudo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/space_l"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <!-- ===== Cabeçalho ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_l">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_drop"
                    app:tint="@color/on_hero" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tela_registro_titulo"
                        android:textAppearance="@style/TextAppearance.App.Display"
                        android:textColor="@color/on_hero" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3xs"
                        android:text="@string/tela_registro_subtitulo"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/on_hero_variant" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Agendamento selecionado (somente-leitura) ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tela_registro_secao_agendamento"
                        android:textAppearance="@style/TextAppearance.App.Label" />

                    <TextView
                        android:id="@+id/txtHemocentro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/txtEndereco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3xs"
                        android:textAppearance="@style/TextAppearance.App.Caption" />

                    <TextView
                        android:id="@+id/txtTipoDoador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3xs"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="?attr/colorPrimary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginBottom="@dimen/space_m"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Data vinda do agendamento: campo travado -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_m"
                        android:hint="@string/campo_data_agendada"
                        app:endIconContentDescription="@string/campo_origem_ajuda"
                        app:endIconDrawable="@drawable/ic_lock"
                        app:endIconMode="custom"
                        app:helperText="@string/campo_origem_ajuda"
                        app:startIconDrawable="@drawable/ic_calendar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:fontFamily="@font/montserrat_medium"
                            android:inputType="none"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Local vindo do agendamento: campo travado -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/campo_local_agendado"
                        app:endIconContentDescription="@string/campo_origem_ajuda"
                        app:endIconDrawable="@drawable/ic_lock"
                        app:endIconMode="custom"
                        app:helperText="@string/campo_origem_ajuda"
                        app:startIconDrawable="@drawable/ic_local">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editLocal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:fontFamily="@font/montserrat_medium"
                            android:inputType="none"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Dados da bolsa (digitados pelo agente) ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/tela_registro_secao_bolsa"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:hint="@string/campo_volume_bolsa"
                app:helperText="@string/campo_volume_ajuda"
                app:startIconDrawable="@drawable/ic_drop">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editVolumeMl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_l"
                android:hint="@string/campo_quantidade"
                app:helperText="@string/campo_quantidade_ajuda"
                app:startIconDrawable="@drawable/ic_layers">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editQuantidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:text="@string/tela_registro_botao"
                app:icon="@drawable/ic_drop"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoltar"
                style="@style/Widget.App.Button.Text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/tela_voltar" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
