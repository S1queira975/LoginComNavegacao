<?xml version="1.0" encoding="utf-8"?>
<!--
    Fluxo do agente de saúde: escolha do agendamento antes de registrar a coleta.

    A tela é somente-leitura. Data, hora e local vêm do agendamento escolhido
    pelo doador, então nada é digitado aqui; o registro em si acontece na
    RegistrarDoacaoActivity. O RecyclerView usa AutoFitGridLayoutManager para
    ganhar colunas sozinho em telas largas.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootConteudo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/conteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_l"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <!-- ===== Cabeçalho ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_drop"
                app:tint="@color/on_hero" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tela_doacao_titulo"
                    android:textAppearance="@style/TextAppearance.App.Display"
                    android:textColor="@color/on_hero" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3xs"
                    android:text="@string/tela_doacao_subtitulo"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/on_hero_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Lista de agendamentos elegíveis ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/tela_doacao_secao"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAgendamentos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_xs"
            android:scrollbars="none" />

        <!-- Estado vazio: nada a registrar agora -->
        <LinearLayout
            android:id="@+id/estadoVazio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_inbox"
                app:tint="?attr/colorOutline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/tela_doacao_vazio"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/tela_doacao_vazio_dica"
                android:textAppearance="@style/TextAppearance.App.Caption" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgendamentos"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/tela_doacao_botao_agendar"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltar"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:text="@string/tela_voltar"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
