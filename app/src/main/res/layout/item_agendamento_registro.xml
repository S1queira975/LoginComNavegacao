<?xml version="1.0" encoding="utf-8"?>
<!--
    Item da lista de agendamentos elegíveis para registro de coleta.

    O card é somente-leitura: a coleta em si é confirmada na tela seguinte.
    O toque no card inteiro dispara a ação, e a pílula à direita mostra o
    status que o agendamento tem no momento.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.MenuCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_3xs"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="?attr/colorPrimaryContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <ImageView
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@null"
            android:padding="@dimen/space_xs"
            android:src="@drawable/ic_calendar"            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtHemocentro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <TextView
                android:id="@+id/txtDataHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xs"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/txtEndereco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatus"
            style="@style/Widget.App.StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:paddingTop="@dimen/space_2xs"
            android:paddingBottom="@dimen/space_2xs" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
