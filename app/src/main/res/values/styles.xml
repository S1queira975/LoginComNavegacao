<?xml version="1.0" encoding="utf-8"?>
<!--
    Estilos de componente.

    Todos resolvem cor por ?attr/... (nunca por cor literal), portanto acompanham
    a troca light/dark e garantem contraste com o fundo em que sao usados.
-->
<resources>

    <!-- ================= Formas ================= -->
    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/corner_m</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/corner_l</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ================= Tipografia ================= -->
    <!-- Preserva a identidade: Bungee nos titulos, Montserrat no corpo -->
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/bungee</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Hero" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/bungee</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/on_hero</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.App.Pill" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Numero grande dos indicadores e selo de tipo sanguíneo do cartazinho -->
    <style name="TextAppearance.App.Metric" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/bungee</item>
        <item name="android:textSize">@dimen/text_metric</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!--
        Selo de tipo sanguíneo. Fica sobre o circulo/pilula claros da marca, por
        isso usa brand_on_badge (o mesmo vermelho do logo) em vez de colorOnSurface.
    -->
    <style name="TextAppearance.App.BloodType" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/bungee</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/brand_on_badge</item>
    </style>

    <!-- ================= Botoes ================= -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">@dimen/space_xs</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:textColor">?attr/colorError</item>
        <item name="iconTint">?attr/colorError</item>
    </style>

    <style name="Widget.App.Button.Compact" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/button_height_small</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Pill</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- ================= Cartoes ================= -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
    </style>

    <style name="Widget.App.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
    </style>

    <!-- Card de acao da Home: clique com ripple, icone + titulo + descricao -->
    <style name="Widget.App.MenuCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Large</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- ================= Campos ================= -->
    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Spinner legado: mesmo visual do campo de texto -->
    <style name="Widget.App.Spinner" parent="">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:minHeight">@dimen/field_min_height</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:popupTheme">@style/ThemeOverlay.App.Spinner</item>
        <item name="android:popupBackground">@drawable/bg_spinner_popup</item>
    </style>

    <!-- ================= Pílula de status ================= -->
    <!-- A cor do fundo e do texto e definida em runtime pelo adapter (status_*_container / status_*) -->
    <style name="Widget.App.StatusPill" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">@dimen/space_3xs</item>
        <item name="android:paddingBottom">@dimen/space_3xs</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Pill</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ================= Snackbars ================= -->
    <style name="Widget.App.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="android:layout_margin">@dimen/space_m</item>
    </style>

    <style name="Widget.App.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>

    <!-- ================= Overlays ================= -->
    <style name="ThemeOverlay.App.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/colorSurfaceContainerHigh</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="ThemeOverlay.App.Spinner" parent="ThemeOverlay.AppCompat">
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="colorSurface">?attr/colorSurface</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
    </style>

</resources>