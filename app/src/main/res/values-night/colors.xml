<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta do tema ESCURO (Material 3).

    Mesmos nomes de recurso de values/colors.xml, com tonalidades invertidas.
    Como o app inteiro le os papeis do tema (nunca cores literais), o Material 3
    troca light/dark sozinho e todo par X/onX continua acima de WCAG AA.
-->
<resources>

    <!-- ===== Primario ===== -->
    <color name="md_primary">#FFB3B2</color>
    <color name="md_on_primary">#680010</color>
    <color name="md_primary_container">#8C1720</color>
    <color name="md_on_primary_container">#FFDAD8</color>

    <!-- ===== Secundario ===== -->
    <color name="md_secondary">#E7BDBB</color>
    <color name="md_on_secondary">#442927</color>
    <color name="md_secondary_container">#5D3F3E</color>
    <color name="md_on_secondary_container">#FFDAD8</color>

    <!-- ===== Terciario ===== -->
    <color name="md_tertiary">#FFB2B0</color>
    <color name="md_on_tertiary">#63131A</color>
    <color name="md_tertiary_container">#7F2B33</color>
    <color name="md_on_tertiary_container">#FFDADB</color>

    <!-- ===== Erro / cancelamento ===== -->
    <color name="md_error">#FFB4AB</color>
    <color name="md_on_error">#690005</color>
    <color name="md_error_container">#93000A</color>
    <color name="md_on_error_container">#FFDAD6</color>

    <!-- ===== Superficies ===== -->
    <color name="md_background">#1A1110</color>
    <color name="md_on_background">#F1DEDC</color>
    <color name="md_surface">#1A1110</color>
    <color name="md_on_surface">#F1DEDC</color>
    <color name="md_surface_variant">#534342</color>
    <color name="md_on_surface_variant">#D8C2C0</color>

    <color name="md_surface_dim">#1A1110</color>
    <color name="md_surface_bright">#413130</color>
    <color name="md_surface_container_lowest">#140C0B</color>
    <color name="md_surface_container_low">#231918</color>
    <color name="md_surface_container">#271D1C</color>
    <color name="md_surface_container_high">#322725</color>
    <color name="md_surface_container_highest">#3D322F</color>

    <!-- ===== Contornos ===== -->
    <color name="md_outline">#A08C8B</color>
    <color name="md_outline_variant">#534342</color>
    <color name="md_inverse_surface">#F1DEDC</color>
    <color name="md_inverse_on_surface">#392E2D</color>
    <color name="md_inverse_primary">#A32C31</color>

    <!-- ===== Gradiente do topo (ainda vermelho, porem para nao ofuscar o texto) ===== -->
    <color name="hero_start">#17100F</color>
    <color name="hero_end">#4E1A1D</color>

    <!-- ===== Status (texto claro sobre container escuro) ===== -->
    <color name="status_pendente">#FFB959</color>
    <color name="status_pendente_container">#5C3B00</color>
    <color name="status_confirmado">#7ADBA1</color>
    <color name="status_confirmado_container">#00522F</color>
    <color name="status_cancelado">#FFB4AB</color>
    <color name="status_cancelado_container">#7A0B12</color>
    <color name="status_realizado">#A2C9FF</color>
    <color name="status_realizado_container">#0A3C6E</color>

</resources>