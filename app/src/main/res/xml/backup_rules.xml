<?xml version="1.0" encoding="utf-8"?><!--
   Regras de backup para Android 11 e anteriores (API <= 30).
   Este arquivo e ignorado a partir do Android 12, que usa data_extraction_rules.xml.
   Ver https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
        O doador e salvo em SharedPreferences com a senha em texto puro.
        Enviar esse arquivo para a nuvem colocaria a senha de todos os
        doadores em um servidor que nao e da aplicacao, entao ele fica
        de fora do backup.
    -->
    <exclude
        domain="sharedpref"
        path="PrefDoacaoSangue.xml" />
</full-backup-content>
