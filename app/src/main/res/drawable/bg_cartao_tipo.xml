<?xml version="1.0" encoding="utf-8"?>
<!--
    Selo grande do tipo sanguíneo no cartazinho.

    Ao contrário da pílula branca (bg_pill_badge), aqui o bloco é vermelho da
    marca e o texto é branco: é o miolo do cartão, então precisa do peso visual
    de uma etiqueta impressa, não de um adesivo claro.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/hero_start" />
    <!-- Mesmo raio do cartão, para o selo e o cartazinho lerem como um conjunto -->
    <corners android:radius="@dimen/corner_m" />
</shape>
